# Sourced by lefthook before every hook. Git GUIs (VS Code's Source Control)
# don't load your shell profile, so find mise and put its tools (Bun, Node,
# Moth) on PATH.
for candidate in "$(command -v mise 2>/dev/null)" "$HOME/.local/bin/mise" /opt/homebrew/bin/mise /usr/local/bin/mise; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    eval "$("$candidate" env -s bash)"
    break
  fi
done
